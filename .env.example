# =============================================================================
# QA Dashboard — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# --- Jira (TMT0 — main project) ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_USER_EMAIL=your.email@company.com
JIRA_API_TOKEN=your_jira_api_token_here
# Get token at: https://id.atlassian.com/manage-profile/security/api-tokens

# --- K-1 KONE Jira (separate Jira instance) ---
KONE_JIRA_BASE_URL=https://kabatone-ops-it.atlassian.net
KONE_JIRA_EMAIL=your.email@kabatone.com
KONE_JIRA_TOKEN=your_kone_jira_api_token_here

# --- Anthropic (AI features: test generation, bug AI, handover criteria) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Figma (design context for test generation) ---
FIGMA_API_TOKEN=figd_...

# --- Zoho Desk (K-1 Support ticket integration) ---
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_DESK_PORTAL=cityshob
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DESK_BASE_URL=https://desk.zoho.com

# --- CI Portal (internal test-run results — Staging AS pass rate) ---
CI_PORTAL_URL=http://192.168.35.149:8081
CI_PORTAL_STAGING_SUITE_ID=5

# --- Web login (dashboard auth) ---
WEBCLIENT_USER=loro
WEBCLIENT_PASSWORD=your_webclient_password
AUTH_ADMIN_PASSWORD=Admin@2026
AUTH_QA_PASSWORD=Qa@2026

# --- Field Mapping Config ---
FIELD_MAPPING_PATH=./config/field_mapping.yaml

# --- Cache Settings ---
CACHE_TTL_SECONDS=300          # 5 minutes auto-refresh
BACKGROUND_REFRESH_HOURS=5     # Full deep-refresh every 5 hours

# --- Database (SQLite — volume-mounted in Docker) ---
DATABASE_URL=sqlite+aiosqlite:///./data/qa_dashboard.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/qa_dashboard

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=production          # development | production

# --- CORS (Frontend origin) ---
# Docker: frontend is on port 3000; add your server IP if needed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"

# --- Export ---
EXPORT_MAX_ROWS=10000

# --- Jira API Limits ---
JIRA_MAX_RESULTS=100
JIRA_REQUEST_TIMEOUT=30
